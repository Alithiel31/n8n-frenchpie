# Copier ce fichier en .env et remplir avec de vraies valeurs.
# Ne JAMAIS commiter le fichier .env (deja ignore via .gitignore).

# IP Tailscale de la machine qui fait tourner n8n (sert a N8N_HOST et WEBHOOK_URL)
N8N_HOST=<IP_TAILSCALE_HOTE_N8N>

# IP Tailscale de l'hote Postgres mutualise
DB_HOST=<IP_TAILSCALE_HOTE_POSTGRES>

# Domaine Infisical (MagicDNS Tailscale + port) et ID du projet contenant les secrets.
# Le domaine et l'ID de projet ne sont pas des secrets a proprement parler, mais ils
# identifient ton infra - ne les publie pas si ce depot est public, garde-les
# uniquement dans ce .env local (deja ignore par git).
INFISICAL_DOMAIN=http://<TON_TAILNET>.ts.net:8090/api
INFISICAL_PROJECT_ID=<ID_PROJET_INFISICAL>

# Les secrets suivants ne vivent plus ici : ils sont geres dans Infisical
# (projet "Shared Keys", environnement prod) et injectes automatiquement
# au deploiement via deploy.sh. Voir README.md.
#   - N8N_ENCRYPTION_KEY
#   - N8N_DB_PASS
