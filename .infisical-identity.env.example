# Copier ce fichier en .infisical-identity.env (jamais commite, voir .gitignore).
# Identifiants de la Machine Identity "n8n-deploy" a creer dans Infisical
# (Shared Keys > Access Control > Machine Identities) - meme pattern que
# "woodpecker-ci-deploy", une identite dediee par service.
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=changeme
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=changeme
